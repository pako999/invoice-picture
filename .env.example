# Neon PostgreSQL — https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=racuni@tvoje-podjetje.si

# Clerk — https://clerk.com/dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your_clerk_publishable_key>
CLERK_SECRET_KEY=<your_clerk_secret_key>
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# Vercel Cron authorization. Use a long random value in Production.
CRON_SECRET=<random_32_or_more_bytes>

# ─────────────────────────────────────────────────────────────────────────────
# Invoice Intelligence / OCR
# ─────────────────────────────────────────────────────────────────────────────
# Primary reader: Mistral OCR + Document AI structured annotations.
MISTRAL_API_KEY=<your_mistral_api_key>
# Keep configurable so a provider upgrade does not require a code change.
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Critical-field minimum confidence, 0..1. Conservative default: 0.92.
INVOICE_CONFIDENCE_THRESHOLD=0.92
# Decimal-safe validation tolerance in invoice currency units.
INVOICE_MONETARY_TOLERANCE=0.02
# Hard provider timeout in milliseconds.
INVOICE_OCR_TIMEOUT_MS=90000
# Durable DB worker batch size per Vercel cron invocation.
INVOICE_CRON_BATCH_SIZE=3
# Original private document retention in days. Set 0 only if you intentionally
# want no automatic retention date (manual deletion remains available).
INVOICE_RETENTION_DAYS=365
# HMAC secret for short-lived private document URLs. Generate at least 32 bytes.
DOCUMENT_URL_SIGNING_SECRET=<random_32_or_more_bytes>

# Cost accounting. Mistral annotated-page default is represented in micro-USD.
# Override if your contracted/provider price differs.
MISTRAL_ANNOTATED_PAGE_COST_MICROS=5000

# Optional fallback: Azure Document Intelligence. Leave unset to disable.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your_azure_key>
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
# Optional cost tracking. Set to your actual per-page price in micro-USD.
AZURE_PAGE_COST_MICROS=0

# Admin allowlist, comma-separated. Existing defaults in lib/admin.ts still apply.
ADMIN_EMAILS=admin@example.com
