# Neon PostgreSQL — https://neon.tech
# Kopiraj "Connection string" iz Neon dashboarda (pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address (mora biti verificiran v Resend)
RESEND_FROM=racuni@tvoje-podjetje.si

# Clerk — https://clerk.com/dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your_clerk_publishable_key>
CLERK_SECRET_KEY=<your_clerk_secret_key>

# Paddle (Billing) — web checkout on the pricing page.
# NEXT_PUBLIC_PADDLE_ENV MUST match the token: a "live_" token needs
# "production", a "test_" token needs "sandbox". A mismatch is the usual cause
# of Paddle's "Something went wrong" overlay after the checkout opens.
# Production also requires the domain to be approved in Paddle:
#   Paddle Dashboard → Checkout → Website approval (add www.posljiracun.si).
# Price IDs (pri_...) must come from the SAME environment as the token.
NEXT_PUBLIC_PADDLE_ENV=production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PADDLE_BASIC_MONTHLY_PRICE_ID=pri_xxx
NEXT_PUBLIC_PADDLE_BASIC_YEARLY_PRICE_ID=pri_xxx
NEXT_PUBLIC_PADDLE_PRO_MONTHLY_PRICE_ID=pri_xxx
NEXT_PUBLIC_PADDLE_PRO_YEARLY_PRICE_ID=pri_xxx
# Server-side webhook signature secret (Paddle Dashboard → Notifications).
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx

# Apple In-App Purchase verification (App Store Server API)
# Used by /api/apple-iap/verify. This uses the modern App Store Server API
# (signed JWT via an In-App Purchase key) — NOT the legacy shared-secret /verifyReceipt.
# Create the key in App Store Connect → Users and Access → Integrations → In-App Purchase.
APPLE_BUNDLE_ID=si.posljiracun.app
APPLE_IAP_KEY_ID=<your_in_app_purchase_key_id>
APPLE_IAP_ISSUER_ID=<your_issuer_id>
# Contents of the .p8 private key. Use literal \n for newlines if stored on one line.
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional: override the pinned Apple Root CA - G3 SHA-256 fingerprint used by
# the /api/apple-iap/notifications webhook. Confirm the default in lib/apple-iap.ts
# against https://www.apple.com/certificateauthority/ before going live.
# APPLE_ROOT_CA_G3_SHA256=
