# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=racuni@tvoje-podjetje.si

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your_clerk_publishable_key>
CLERK_SECRET_KEY=<your_clerk_secret_key>
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
ADMIN_EMAILS=admin@example.com

# Vercel Cron / signing
CRON_SECRET=<random_32_or_more_bytes>
DOCUMENT_URL_SIGNING_SECRET=<random_32_or_more_bytes>
DELIVERY_SECRET_ENCRYPTION_KEY=<random_32_or_more_bytes>

# Invoice Intelligence / OCR
MISTRAL_API_KEY=<your_mistral_api_key>
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_ANNOTATED_PAGE_COST_MICROS=5000
INVOICE_CONFIDENCE_THRESHOLD=0.92
INVOICE_MONETARY_TOLERANCE=0.02
INVOICE_OCR_TIMEOUT_MS=90000
INVOICE_CRON_BATCH_SIZE=5
INVOICE_UPLOADS_PER_MINUTE=300
INVOICE_RETENTION_DAYS=365
INVOICE_DELIVERY_BATCH_SIZE=5
INVOICE_MAX_OCR_PAGES_PER_DOCUMENT=25
INVOICE_MAX_OCR_PAGES_PER_CRON=40
INVOICE_MAX_DOCUMENTS_PER_CRON=5
# Emergency circuit breakers only. Commercial limits are defined per plan in lib/plans.ts.
INVOICE_GLOBAL_EMERGENCY_DAILY_OCR_PAGE_LIMIT=10000
INVOICE_GLOBAL_EMERGENCY_MONTHLY_OCR_PAGE_LIMIT=100000

# Optional Azure fallback
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your_azure_key>
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-invoice
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_PAGE_COST_MICROS=0

# Paddle v2 checkout. Do NOT point these at legacy 6.99/17.99 price IDs.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=<paddle_client_token>
NEXT_PUBLIC_PADDLE_ENV=production
PADDLE_WEBHOOK_SECRET=<paddle_webhook_secret>
NEXT_PUBLIC_PADDLE_V2_BASIC_MONTHLY_PRICE_ID=<price_9_90_monthly>
NEXT_PUBLIC_PADDLE_V2_BASIC_YEARLY_PRICE_ID=<price_99_yearly>
NEXT_PUBLIC_PADDLE_V2_PRO_MONTHLY_PRICE_ID=<price_29_90_monthly>
NEXT_PUBLIC_PADDLE_V2_PRO_YEARLY_PRICE_ID=<price_299_yearly>
NEXT_PUBLIC_PADDLE_V2_ACCOUNTING_PRO_MONTHLY_PRICE_ID=<price_119_90_monthly>
NEXT_PUBLIC_PADDLE_V2_ACCOUNTING_PRO_YEARLY_PRICE_ID=<price_1199_yearly>
NEXT_PUBLIC_PADDLE_V2_ACCOUNTING_MAX_MONTHLY_PRICE_ID=<price_269_90_monthly>
NEXT_PUBLIC_PADDLE_V2_ACCOUNTING_MAX_YEARLY_PRICE_ID=<price_2699_yearly>
